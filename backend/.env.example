# 复制为 backend/.env，填入本地数据库密码；Spring 会将其作为 properties 文件读取。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=bill_assistant
MYSQL_USER=bill_assistant
MYSQL_PASSWORD=replace-with-your-local-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# Capacitor App 的跨源来源，多个来源用逗号分隔。
APP_CORS_ALLOWED_ORIGINS=http://localhost,capacitor://localhost

# Access JWT 默认 15 分钟，Refresh 会话默认 30 天绝对期限。
AUTH_ACCESS_MAX_AGE_SECONDS=900
AUTH_REFRESH_MAX_AGE_SECONDS=2592000
AUTH_REFRESH_GRACE_SECONDS=5
# 必填：用 openssl rand -base64 48 生成一次并持久保存，不同实例应使用同一个密钥。
AUTH_JWT_SECRET=replace-with-base64-encoded-random-secret
# HTTPS 部署时设为 true。
AUTH_COOKIE_SECURE=false
